# Server
NODE_ENV=production
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=10

# Redis
REDIS_URL=rediss://default:<password>@<host>:<port>

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_token_key_min_64_characters_long_value_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_min_64_characters_long_value_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://your-frontend-domain.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Analytics
IP_HASH_SALT=your_random_salt_for_ip_hashing_min_16_chars
ANALYTICS_RETENTION_DAYS=90

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email / SMTP
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=no-reply@your-domain.com
SMTP_PASS=your_smtp_password
OWNER_EMAIL=your-personal-email@domain.com
